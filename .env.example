# The demo does not need a database URL. Each browser stores its ledger in IndexedDB.
# Copy this file to .env only if you are wiring optional CI secrets locally.

# Mabl — only API keys / bypass tokens are secrets. Do not commit real values.
# IDs below are public Dariten identifiers (also defaulted in .github/workflows/ci.yml).
MABL_API_KEY=
# Must match Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation.
# GitHub Actions sends it as the x-vercel-protection-bypass header on mabl runs.
VERCEL_AUTOMATION_BYPASS_SECRET=
MABL_WORKSPACE_ID=Tyl0bVDkrVJ7yJn9DF6Elg-w
MABL_APPLICATION_ID=IzDXT4hknwruhKOu7DOyaA-a
MABL_ENVIRONMENT_ID=NmGUfHqpSgZFF0DInEGpDg-e
