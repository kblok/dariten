# Local Docker / local Postgres (see README)
DATABASE_URL="postgresql://quicken:quicken@localhost:5432/quicken_demo"

# Neon (Vercel / production)
# Use the pooled connection string from the Neon console for the Next.js app.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
#
# If you later point DATABASE_URL at Neon's pooler, set DIRECT_URL to the
# unpooled connection string and add `directUrl = env("DIRECT_URL")` in
# prisma/schema.prisma so `prisma migrate` can run.
# DIRECT_URL=""

# Mabl placeholders for GitHub Actions. Store real values as repository secrets.
# Do not commit API keys. Workspace / application / environment IDs are documented in the README.
MABL_API_KEY=
MABL_WORKSPACE_ID=
MABL_APPLICATION_ID=
MABL_ENVIRONMENT_ID=
